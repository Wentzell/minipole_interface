[build-system]
requires = ["setuptools"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["python"]

[project]
name = "minipole_interface"
version = "@PROJECT_VERSION@"
authors = [
  { name="TRIQS", email="triqs@flatironinstitute.org" }
]
description = "TRIQS interface to the MiniPole analytic continuation package"
readme = "README.md"
keywords = ["triqs", "mini_pole", "analytic continuation", "minimal pole method"]
requires-python = ">=3.8"
classifiers = [
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: GNU General Public License v3 (GPLv3)",
    "Operating System :: OS Independent",
]
dependencies = [
    "numpy",
    "scipy",
    "mini_pole==0.7",
    "kneed",
]

[project.urls]
"Homepage" = "https://triqs.github.io/minipole_interface"
"Bug Tracker" = "https://github.com/triqs/minipole_interface/issues"

# in case you want an executable hook of your app
# [project.scripts]
# solid_dmft = "solid_dmft.main:main"

